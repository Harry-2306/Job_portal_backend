# Django Secret Key
SECRET_KEY=django-insecure-change-this-in-production-job-portal-secret-key-12345

# Debug Mode
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# If DB_NAME is set and PostgreSQL is running, it will connect to PostgreSQL.
# Otherwise, it falls back gracefully to SQLite for instant local development/testing.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=job_portal_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional full database URL (e.g. postgres://user:password@localhost:5432/job_portal_db)
# DATABASE_URL=
